{
  "name": "link-cache",
  "version": "0.4.0",
  "description": "Zero-dependency helper CLIs for cached Lychee link-checking around an owned JSONC cache (link-cache.jsonc) with provenance: lychee-norm-cache (run + sync caches) and link-cache (inspect/prune).",
  "keywords": [
    "lychee",
    "link-checker",
    "link-checking",
    "cache",
    "cli"
  ],
  "homepage": "https://github.com/chalin/link-cache#readme",
  "bugs": "https://github.com/chalin/link-cache/issues",
  "repository": "github:chalin/link-cache",
  "license": "Apache-2.0",
  "author": "Patrice Chalin",
  "type": "module",
  "bin": {
    "lychee-norm-cache": "check/index.mjs",
    "link-cache": "link-cache/index.mjs",
    "refcache": "link-cache/index.mjs"
  },
  "files": [
    "check/index.mjs",
    "lib/cache.mjs",
    "link-cache/index.mjs"
  ],
  "scripts": {
    "check": "npm run check:format && npm test",
    "check:format": "prettier --check .",
    "fix:format": "prettier --write .",
    "install:safe": "npm ci --ignore-scripts --no-audit --no-fund",
    "test": "node --test"
  },
  "prettier": {
    "proseWrap": "always",
    "singleQuote": true
  },
  "devDependencies": {
    "prettier": "^3.9.4"
  },
  "engines": {
    "node": ">=24"
  }
}
