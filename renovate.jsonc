{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    ":configMigration",
    "helpers:pinGitHubActionDigests",
    "helpers:githubDigestChangelogs",
  ],
  "enabledManagers": ["github-actions", "npm", "nvm"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      // Actions are looked up as GitHub Releases, and a bump's branch name
      // carries its SHA; why: _docs/supply-chain.md § Pinned actions.
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "overrideDatasource": "github-releases",
      "branchTopic": "{{{depNameSanitized}}}-{{{newDigest}}}",
    },
  ],
  "schedule": ["* * * * 0"], // Sunday (UTC)
  "labels": ["dependencies"],
}
