{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    ":configMigration",
    "helpers:pinGitHubActionDigests",
    "helpers:githubDigestChangelogs",
  ],
  "enabledManagers": ["github-actions", "npm", "nvm"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      // Actions are looked up as GitHub Releases, whose publication date GitHub
      // sets; the default github-tags lookup falls back to the git commit or
      // tagger date, which whoever pushes the tag chooses. The cooldown still
      // can't bind a version to its code: a release's tag can be re-pointed
      // after it has aged, so every action update waits for a dashboard tick,
      // taken after the maintainer has checked the SHA (_docs/supply-chain.md).
      // The SHA in the branch name makes each tick good for that SHA only.
      "matchManagers": ["github-actions"],
      "overrideDatasource": "github-releases",
      "dependencyDashboardApproval": true,
      "branchTopic": "{{{depNameSanitized}}}-{{{newDigest}}}",
    },
  ],
  "schedule": ["* * * * 0"], // Sunday (UTC)
  "labels": ["dependencies"],
}
