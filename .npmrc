# npm supply-chain controls; shared rationale (cross-repo one-home):
# https://opentelemetry.io/site/design/supply-chain-security/

min-release-age=7
strict-allow-scripts=true
engine-strict=true

# Execution default-deny: no dependency here needs lifecycle scripts
# (prettier is the only dev dep).
ignore-scripts=true

# One script interpreter on every platform (Windows npm defaults to cmd.exe,
# whose quoting silently diverges from sh).
script-shell=bash
